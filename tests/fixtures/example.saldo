account Assets:Cash      = 5_000
account Assets:Retirement:Jim
account Assets:Retirement:Beth
account Liabilities:Loan = -30_000
account Liabilities:AccruedInterest
account Income:Gross:Salary:Jim
account Income:Gross:Salary:Beth
account Income:Gross:Bonus
account Expenses:Interest

param max_401k : usd/year = 24_500
param interest_rate       = 0.05

param jim_salary : usd/year {
  from 2025-12-31 to 2026-04-01 = 115_000
  from 2026-04-01               = 130_000
}

param beth_salary : usd/year {
  from 2026-01-01 to 2027-01-01 = 160_000
  from 2027-01-01 to 2028-01-01 = 190_000
  from 2028-01-01 to 2029-01-01 = 225_000
  from 2029-01-01 to 2030-01-01 = 255_000
}

param retirement_rate = 0.16
param bonus_amount    = 50_000

entry monthly "Jim's paycheck" {
  Assets:Retirement:Jim = min(max_401k - retirement_contribution.ytd, jim_salary * retirement_rate / 12) as retirement_contribution
  Assets:Cash           = jim_salary / 12 - retirement_contribution
  Income:Gross:Salary:Jim
} as jim_paycheck

entry monthly "Beth's paycheck" {
  Assets:Retirement:Beth = min(max_401k - retirement_contribution.ytd, beth_salary * retirement_rate / 12) as retirement_contribution
  Assets:Cash            = beth_salary / 12 - retirement_contribution
  Income:Gross:Salary:Beth
}

entry yearly "Annual bonus" {
  Assets:Cash = bonus_amount
  Income:Gross:Bonus
}

entry daily "Interest accrual" {
  Liabilities:AccruedInterest = Liabilities:Loan * interest_rate / 365
  Expenses:Interest
}

entry monthly "Loan payment" {
  Liabilities:AccruedInterest = all
  Liabilities:Loan            = 2_000
  Assets:Cash
}

assert Assets:Cash >= 0
assert jim_paycheck.retirement_contribution.ytd <= 24_500
assert 2026-12-31 Assets:Retirement:Beth == 24_500
